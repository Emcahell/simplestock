{
  "expo": {
    "name": "simplestock",
    "slug": "simplestock",
    "icon": "./src/assets/simplestock-logo.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "simplestock",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.simplestock"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/simplestock-logo.png",
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.simplestock"
    },
    "web": {
      "output": "static",
      "bunler": "metro"
    },
    "plugins": ["expo-router", "expo-splash-screen", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26b39b78-084c-4b7a-85c6-af1a397239cf"
      }
    }
  }
}
